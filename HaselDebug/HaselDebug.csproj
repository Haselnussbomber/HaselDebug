<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!-- Project settings -->
  <PropertyGroup>
    <Name>HaselDebug</Name>
    <Version>1.75.3</Version>
    <Author>Haselnussbomber</Author>
    <RepoUrl>https://github.com/Haselnussbomber/HaselDebug</RepoUrl>
    <Punchline>Various tools to debug things.</Punchline>
    <Description>For developers.</Description>
    <LoadRequiredState>1</LoadRequiredState>
    <CanUnloadAsync>true</CanUnloadAsync>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Build settings -->
  <PropertyGroup>
    <OutputPath>..\bin\</OutputPath>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <DefineConstants>$(DefineConstants);AUTOCTOR_EMBED_ATTRIBUTES</DefineConstants>
    <NoWarn>$(NoWarn);Dalamud001</NoWarn>
  </PropertyGroup>

  <!-- Dalamud.NET.Sdk settings -->
  <PropertyGroup>
    <Use_Dalamud_Newtonsoft_Json>false</Use_Dalamud_Newtonsoft_Json>
    <Use_Dalamud_FFXIVClientStructs>false</Use_Dalamud_FFXIVClientStructs>
    <Use_Dalamud_Lumina_Excel>false</Use_Dalamud_Lumina_Excel>
  </PropertyGroup>

  <!-- Assets -->
  <ItemGroup>
    <None Include="..\FFXIVClientStructs\ida\data.yml" Link="data.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Translations.json" Link="$(AssemblyName).Translations.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LICENSES.md" Link="LICENSES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- NuGet dependencies -->
  <ItemGroup>
    <Reference Include="Dalamud.Common" Private="false" />
    <PackageReference Include="AutoCtor" Version="4.0.1" PrivateAssets="all" ExcludeAssets="compile;runtime" />
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="Injectio" Version="6.2.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.360" PrivateAssets="All" />
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="LuminaSupplemental.Excel" Version="5.1.5" />
  </ItemGroup>

  <!-- HaselCommon -->
  <ItemGroup>
    <ProjectReference Include="..\HaselCommon\HaselCommon\HaselCommon.csproj" />
  </ItemGroup>

  <!-- Custom FFXIVClientStructs -->
  <PropertyGroup>
    <InteropGenerator_InteropNamespace>$(AssemblyName)</InteropGenerator_InteropNamespace>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="InteropGenerator_InteropNamespace" />
    <ProjectReference Include="..\FFXIVClientStructs\InteropGenerator\InteropGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FFXIVClientStructs\FFXIVClientStructs\FFXIVClientStructs.csproj" Private="True" />
    <ProjectReference Include="..\FFXIVClientStructs\InteropGenerator.Runtime\InteropGenerator.Runtime.csproj" Private="True" />
  </ItemGroup>

  <!-- Custom Lumina Excel -->
  <PropertyGroup>
    <SchemaPath>$(MSBuildProjectDirectory)\..\Lumina.Excel\deps\EXDSchema-experimental</SchemaPath>
    <GeneratedNamespace>HaselDebug.Excel.Sheets</GeneratedNamespace>
    <UseUsings>true</UseUsings>
    <UseFileScopedNamespace>true</UseFileScopedNamespace>
    <UseSchemaAttribute>false</UseSchemaAttribute>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="SchemaPath" />
    <CompilerVisibleProperty Include="ExperimentalSchemaPath" />
    <CompilerVisibleProperty Include="GeneratedNamespace" />
    <CompilerVisibleProperty Include="UseUsings" />
    <CompilerVisibleProperty Include="UseFileScopedNamespace" />
    <CompilerVisibleProperty Include="UseSchemaAttribute" />
    <ProjectReference Include="..\Lumina.Excel\src\Lumina.Excel.Generator\Lumina.Excel.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" IncludeAssets="all" />
  </ItemGroup>

  <Target Name="DeleteLuminaExcelDocs" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and Exists('$(TargetDir)Lumina.Excel.xml')">
    <Delete Files="$(TargetDir)Lumina.Excel.xml" />
  </Target>
</Project>
